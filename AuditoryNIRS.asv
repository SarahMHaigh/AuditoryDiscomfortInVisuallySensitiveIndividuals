clear all
close all

P = {'N1A' 'N2A' 'N3A' 'N4A' 'N5A' 'N7A' 'N8A' 'N10A' 'N11A'}; 
mod = {'aud'};
sig = 'oxyhb';
path = [pwd '/Data/'];

sample = 10.172526041666666;
x = 0:1/sample:35;
x = x(1:end-1);
window = round(35*sample);
shiftS = 0;
baseS = round(10*sample);

for z = 1:length(P)
    for j = 1:length(mod)
        
        data = load([path P{z} '_' sig '.txt']);
        eventList = load([path P{z} '_event.txt']);
        
        time=(1:length(data))';
                    
        % filter
        Fs=sample/2; % sample rate
        high=.02/Fs; % .02
        low=.1/Fs;
        [B,A]=butter(2,[high low]);
        for i = 1:size(data,2)
            dataS{z,j}(:,i)=filtfilt(B,A,data(:,i));
        end
        
      
        %% Triggers by event type
        % 1 = 10
        % 2 = 01
        % 5 = 11 attention

        oneTrig = [];
        twoTrig = [];

        for i = 1:length(eventList)
            if eventList(i,2) == 1 &&  eventList(i,3) == 0
                sz = length(oneTrig);
                oneTrig(sz+1) = eventList(i,1);
            elseif eventList(i,2) == 0 &&  eventList(i,3) == 1
                sz = length(twoTrig);
                twoTrig(sz+1) = eventList(i,1);
            end
        end
        
        %% Signals for condition 1

        for i = 1:length(oneTrig)
            for k = 1:size(dataS{z,j},2)
                basetemp = mean(dataS{z,j}(oneTrig(i)-baseS:oneTrig(i)-shiftS,k));
                baseSD = std(dataS{z,j}(oneTrig(i)-baseS:oneTrig(i)-shiftS,k));
                ONavg = mean(dataS{z,j}(oneTrig(i):oneTrig(i)+(window-baseS),k));           
                if ONavg/baseSD >0 % change depending on oxy or deoxy signals!!!!!!!!!!!!
                    for g = 1:window
                        temp(g) = dataS{z,j}(oneTrig(i)-baseS+g,k)-basetemp;                   
                    end
                    oneCorr{z,j}{k}(i,:) = temp;
                else oneCorr{z,j}{k}(i,1:window) = NaN;
                end
                clearvars basetemp baseSD ONavg temp minS maxS
            end
        end
        for k = 1:size(oneCorr{z,j},2)
            M_oneCorr{z,j}(k,:) = nanmean(oneCorr{z,j}{k},1);
            Trial_1{z,k}(j) = sum(~isnan(oneCorr{z,j}{k}(:,1)));
        end
        
        if j == 2
            % Auditory channels
            figure;
            for k = 1:4
                plot(M_oneCorr{z,j}(k,:)); hold on;
                R(k,:) = M_oneCorr{z,j}(k,:);
            end
            for k = 15:18
                plot(M_oneCorr{z,j}(k,:)); hold on;
                L(k,:) = M_oneCorr{z,j}(k,:);
            end
            title(['Condition One - Auditory ' P{z} ' ' mod{j} ' sig']);
            One = mean([R; L]);

        elseif j == 1
            % Visual channels
            figure;
            for k = 5:14
                plot(M_oneCorr{z,j}(k,:)); hold on;
                V(k,:) = M_oneCorr{z,j}(k,:);
            end
            title(['Condition One - Visual ' P{z} ' ' mod{j} ' sig']);
            legend;
            One = mean(V);
        end
        
        %% Signals for condition 2

        for i = 1:length(twoTrig)
            for k = 1:size(dataS{z,j},2)
                basetemp = mean(dataS{z,j}(twoTrig(i)-baseS:twoTrig(i)-shiftS,k));
                baseSD = std(dataS{z,j}(twoTrig(i)-baseS:twoTrig(i)-shiftS,k));
                ONavg = mean(dataS{z,j}(twoTrig(i):twoTrig(i)+(window-baseS),k));               
                if ONavg/baseSD >0 % change depending on oxy or deoxy signals!!!!!!!!!!!!
                    for g = 1:window
                        temp(g) = dataS{z,j}(twoTrig(i)-baseS+g,k)-basetemp;                   
                    end
                    twoCorr{z,j}{k}(i,:) = temp;
                else twoCorr{z,j}{k}(i,1:window) = NaN;
                end
                clearvars basetemp baseSD ONavg temp minS maxS
            end
        end
        for k = 1:size(twoCorr{z,j},2)
            M_twoCorr{z,j}(k,:) = nanmean(twoCorr{z,j}{k},1);
            Trial_2{z,k}(j) = sum(~isnan(twoCorr{z,j}{k}(:,1)));
        end
        
        if j == 2
            % Auditory channels
            figure;
            for k = 1:4
                plot(M_twoCorr{z,j}(k,:)); hold on;
                R(k,:) = M_twoCorr{z,j}(k,:);
            end
            for k = 15:18
                plot(M_twoCorr{z,j}(k,:)); hold on;
                L(k,:) = M_twoCorr{z,j}(k,:);
            end
            title(['Condition Two - Auditory ' P{z} ' ' mod{j} ' sig']);
            Two = mean([R; L]);
        elseif j == 1
            % Visual channels
            figure;
            for k = 5:14
                plot(M_twoCorr{z,j}(k,:)); hold on;
                V(k,:) = M_twoCorr{z,j}(k,:);
            end
            title(['Condition Two - Visual ' P{z} ' ' mod{j} ' sig']);
            legend;
            Two = mean(V);
        end

        figure; plot(x,One); hold on; plot(x,Two);
        title(['All Conditions - ' P{z} ' ' mod{j}]);
        
    end

    for k = 1:size(oneCorr{z,j},2)
        NoRej{z,j}{k} = mean(oneCorr{z,j}{k},2);
        NoRej1(k,z,j) = sum(isnan(NoRej{z,j}{k}));    
    end
    clearvars NoRej

    for k = 1:size(twoCorr{z,j},2)
        NoRej{z,j}{k} = mean(twoCorr{z,j}{k},2);
        NoRej2(k,z,j) = sum(isnan(NoRej{z,j}{k}));    
    end
    clearvars NoRej
        
end

%% Overall

for p = 1:length(P)
    OneV(p,:) = nanmean(M_oneCorr{p,1}(5:14,:));
    TwoV(p,:) = nanmean(M_twoCorr{p,1}(5:14,:));
    
    OneA(p,:) = nanmean(M_oneCorr{p,2}([1:4 15:18],:));
    TwoA(p,:) = nanmean(M_twoCorr{p,2}([1:4 15:18],:));
end

OneVp = nanmean(OneV);
TwoVp = nanmean(TwoV);

figure; plot(x,OneVp); hold on; plot(x,TwoVp);
title(['All Conditions - mean of visual channels']);
legend('8Hz alt contrast', '4Hz alt contrast');

OneAp = nanmean(OneA);
TwoAp = nanmean(TwoA);

figure; plot(x,OneAp); hold on; plot(x,TwoAp);
title(['All Conditions - mean of auditory channels']);
legend('1kHz/slow 2Hz mod', '1kHz/fast 16Hz mod');